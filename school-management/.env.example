# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Domain used to convert usernames into auth emails: <username>@USERNAME_DOMAIN
USERNAME_DOMAIN=school.local

# First admin (Principal) credentials - created by developer in Supabase Auth
ADMIN_EMAIL=principal@yourschool.edu
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME="Principal Name"
ADMIN_USERNAME=principal
